# Copy to .env.local and adjust. Only VITE_* variables are readable by the browser.
# NEVER put secrets (API keys, tokens) in any VITE_* variable: they ship in the public bundle.

# Base URL of the Express REST API, e.g. https://api.agrilink.example/api/v1
VITE_API_BASE_URL=

# "true" = use the in-browser mock server (src/mocks). "false" = call the real Express API.
VITE_USE_MOCKS=true
