# Copy to backend/.env (never commit it).

# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database ----
# Local:  mongodb://localhost:27017/agrilink
# Atlas:  mongodb+srv://USER:PASSWORD@cluster.mongodb.net/agrilink
MONGODB_URI=mongodb://localhost:27017/agrilink

# ---- Origins ----
# Browser origin(s) allowed to call the API, comma separated, no trailing slash.
# Development: the Vite server on :3000. Production: your public URL, e.g. https://agrilink.example.com
# (The built app is served by this same server, so in production this just has to match your domain.)
FRONTEND_URL=http://localhost:3000

# ---- Auth ----
# Required, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=11

# ---- Refresh cookie ----
# Leave COOKIE_SECURE unset: it defaults to true when NODE_ENV=production (HTTPS only) and false otherwise.
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# ---- Hosting platform proxy ----
# How many proxies sit in front of this server (Render, Railway, Heroku, Fly: 1). Needed for correct
# client IPs, which the login rate limits depend on. Defaults to 1 in production, 0 otherwise.
# TRUST_PROXY=1

# ---- New listings ----
# off        = every listing goes live immediately (good for a demo)
# unverified = listings from farmers an admin hasn't verified wait for approval
# all        = every listing waits for admin approval
LISTING_APPROVAL=off

# ---- Serving the React app ----
# Express serves frontend/dist when it exists (run `npm run build` first). Override only if you move it.
# STATIC_DIR=../frontend/dist
# SERVE_FRONTEND=false

# ---- Weather (free, no API key) ----
# Providers are tried in this order. If the first is blocked or down on your network, the next one is used.
#   open-meteo  api.open-meteo.com  (free for non-commercial use, with attribution)
#   met-no      api.met.no          (MET Norway, free; needs a User-Agent that names your app and a contact)
WEATHER_PROVIDERS=open-meteo,met-no
# Put your own email or website here before going online; MET Norway asks for it.
WEATHER_USER_AGENT=AgriLink/1.2 (university project)
# How long a forecast is reused before asking the provider again.
WEATHER_CACHE_MINUTES=30
# Not working? Run:  npm run weather:check
